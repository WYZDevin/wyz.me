---
import { Timer } from '@/components/icons/Timer'

import BentoBadge from '../BentoBadge'
import { timelineData } from './timeline'
---

<section aria-label='Education and experience' class='flex flex-col gap-4 p-5'>
  <BentoBadge
    className={{ component: 'w-fit' }}
    icon={Timer}
    text='Education & experience'
  />

  <ol class='timeline space-y-3'>
    {
      timelineData.map(({ period, title, description, icon: Icon }) => (
        <li class='relative grid grid-cols-[2rem_minmax(0,1fr)] items-start gap-x-3'>
          <span
            aria-hidden='true'
            class='theme-timeline-dot relative grid size-8 place-items-center rounded-full'
          >
            <Icon className='size-4 text-theme-inverse' />
          </span>
          <div>
            <div class='flex flex-wrap items-baseline justify-between gap-x-3'>
              <h3 class='text-sm font-semibold text-theme-primary'>{title}</h3>
              <span class='text-xs font-medium text-theme-secondary'>
                {period}
              </span>
            </div>
            <p class='mt-0.5 text-sm leading-snug text-theme-secondary'>
              {description}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .timeline li:not(:last-child)::before {
    position: absolute;
    inset-block: 1rem -1.75rem;
    inset-inline-start: calc(1rem - 1px);
    width: 2px;
    background: var(--timeline-line);
    content: '';
  }
</style>
