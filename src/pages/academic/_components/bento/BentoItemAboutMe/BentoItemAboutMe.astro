---
import { HandWaving } from '@/components/icons/HandWaving'

import BentoBadge from '../BentoBadge'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div
  class:list={['relative flex h-full flex-col justify-between p-6', className]}
>
  <!-- Badge -->
  <div class='mb-6'>
    <BentoBadge
      icon={HandWaving}
      text='About me'
      className={{ component: 'w-fit' }}
    />
  </div>

  <!-- Content -->
  <div class='flex-1 space-y-6'>
    <!-- Main intro -->
    <div class='space-y-4'>
      <h2 class='text-2xl font-semibold leading-tight text-theme-primary'>
        Devin Yongzhao Wu
      </h2>
      <div class='prose space-y-3'>
        <p class='text-base leading-relaxed text-theme-secondary'>
          I study movement, urban environments, and environmental exposure. My
          research interests include spatiotemporal machine learning, multimodal
          GeoAI, and connecting language models with geospatial tools.
        </p>
        <p class='text-base leading-relaxed text-theme-secondary'>
          Previously, as a GIS Developer at Arima Data, I built cloud pipelines
          processing over 18 billion GPS records, optimized mobility analytics,
          and developed interactive 3D trajectory visualizations.
        </p>
      </div>
    </div>

    <!-- Quick stats/highlights -->
    <div class='grid grid-cols-2 gap-4 pt-4'>
      <div class='space-y-1'>
        <div class='text-lg font-semibold text-theme-primary'>
          PhD Researcher
        </div>
        <div class='text-xs text-theme-secondary'>University of Toronto</div>
        <div class='text-xs text-theme-secondary'>Expected June 2028</div>
      </div>
      <div class='space-y-1'>
        <div class='text-lg font-semibold text-theme-primary'>
          Research Focus
        </div>
        <div class='text-xs text-theme-secondary'>Mobility Modeling</div>
        <div class='text-xs text-theme-secondary'>Environmental Exposure</div>
        <div class='text-xs text-theme-secondary'>Space-Time ML</div>
        <div class='text-xs text-theme-secondary'>LLMs + Geospatial Tools</div>
      </div>
      <div class='col-span-2 space-y-1'>
        <div class='text-lg font-semibold text-theme-primary'>
          Teaching · Fall 2026
        </div>
        <div class='text-xs text-theme-secondary'>
          Course instructor for Space Time Data Analysis at the University of
          Toronto, emphasizing reproducible workflows, critical interpretation,
          and responsible use of AI-assisted coding.
        </div>
        <a
          href='/ggr444/'
          class='inline-block text-sm font-medium underline underline-offset-4 accent-primary'
        >
          Explore course examples →
        </a>
      </div>
    </div>
  </div>

  <!-- Subtle background decoration -->
  <div
    class='from-primary-400/10 to-primary-600/5 absolute -right-4 -top-4 h-24 w-24 rounded-full bg-gradient-to-br blur-xl'
  >
  </div>
  <div
    class='absolute -bottom-6 -left-2 h-16 w-16 rounded-full bg-gradient-to-tr from-emerald-400/10 to-emerald-600/5 blur-lg'
  >
  </div>
</div>
